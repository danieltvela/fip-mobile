// Prisma schema: domain data model. Issue #4 owns the Journalist auth model;
// mainline owns media gallery (#10), agenda/notifications (#12) and the press
// room Material model (#8, #9). Keep migrations reproducible: `prisma migrate
// dev` against a local PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaType {
  note
  dossier
  image
  video
  audio
}

model Edition {
  id    String      @id @default(cuid())
  name  String      @unique
  items MediaItem[]
}

model Event {
  id    String      @id @default(cuid())
  name  String      @unique
  items MediaItem[]
}

/// A piece of press material. Binary payloads live in blob storage
/// (keyed by `previewKey` / `originalKey`); metadata lives here.
model MediaItem {
  id          String    @id @default(cuid())
  title       String
  type        MediaType
  topic       String
  /// Compact rendition shown in list thumbnails and detail preview.
  previewKey  String
  /// Full-quality rendition exposed for download.
  originalKey String
  mimeType    String
  sizeBytes   Int
  publishedAt DateTime
  editionId   String?
  edition     Edition?  @relation(fields: [editionId], references: [id])
  eventId     String?
  event       Event?    @relation(fields: [eventId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([publishedAt(sort: Desc)])
}

// The login credential is the press-team-issued journalist credential number.
// Only its scrypt hash is stored; the plaintext never leaves the request body.
model Journalist {
  id               String    @id @default(cuid())
  credentialNumber String    @unique
  credentialHash   String
  name             String
  outlet           String
  role             String
  refreshTokenHash String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

enum AgendaRequestKind {
  INTERVIEW
  MEETING
  SHOOTING_SLOT
  EVENT
}

enum AgendaRequestStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum NotificationTypology {
  PRESS_NOTE
  AGENDA_CHANGE
  INTERVIEW
  PRIVATE_COMMUNICATION
  INCIDENT
}

enum UserRole {
  PRESS
  JOURNALIST
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String
  role           UserRole        @default(JOURNALIST)
  createdAt      DateTime        @default(now())
  agendaRequests AgendaRequest[]
  notifications  Notification[]
}

model AgendaRequest {
  id              String              @id @default(cuid())
  kind            AgendaRequestKind
  status          AgendaRequestStatus @default(PENDING)
  scheduledAt     DateTime
  notes           String?
  durationMinutes Int                 @default(30)
  journalistId    String
  journalist      User                @relation(fields: [journalistId], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([journalistId])
}

model Notification {
  id        String               @id @default(cuid())
  typology  NotificationTypology
  title     String
  body      String
  data      Json?
  userId    String
  user      User                 @relation(fields: [userId], references: [id])
  readAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId])
}

enum MaterialType {
  note
  dossier
  image
  video
  audio
}

enum MaterialTopic {
  events
  forums
  agenda
  institutional
  other
}

/// Press room material published by the press office.
model Material {
  id        String        @id @default(cuid())
  title     String
  type      MaterialType
  topic     MaterialTopic
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("materials")
}
