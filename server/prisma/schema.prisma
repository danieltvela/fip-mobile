// Domain data model. Issue #4 owns the Journalist auth model; issue #3
// (media gallery) owns the media models. Keep migrations reproducible:
// `prisma migrate deploy` against a local PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaType {
  note
  dossier
  image
  video
  audio
}

model Edition {
  id    String @id @default(cuid())
  name  String @unique
  items MediaItem[]
}

model Event {
  id    String @id @default(cuid())
  name  String @unique
  items MediaItem[]
}

/// A piece of press material. Binary payloads live in blob storage
/// (keyed by `previewKey` / `originalKey`); metadata lives here.
model MediaItem {
  id             String    @id @default(cuid())
  title          String
  type           MediaType
  topic          String
  /// Compact rendition shown in list thumbnails and detail preview.
  previewKey     String
  /// Full-quality rendition exposed for download.
  originalKey    String
  mimeType       String
  sizeBytes      Int
  publishedAt    DateTime
  editionId      String?
  edition        Edition?  @relation(fields: [editionId], references: [id])
  eventId        String?
  event          Event?    @relation(fields: [eventId], references: [id])
  createdAt      DateTime  @default(now())

  @@index([publishedAt(sort: Desc)])
}

// The login credential is the press-team-issued journalist credential number.
// Only its scrypt hash is stored; the plaintext never leaves the request body.
model Journalist {
  id               String    @id @default(cuid())
  credentialNumber String    @unique
  credentialHash   String
  name             String
  outlet           String
  role             String
  refreshTokenHash String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
